# Database Configuration
# SQLite database file (will be created automatically)
DATABASE_URL=file:mazdor.db

# Session Configuration (auto-generated by nuxt-auth-utils)
# This will be created automatically if not present
# NUXT_SESSION_PASSWORD=

# OAuth Configuration (optional - only if using social login)
# Google OAuth
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Facebook OAuth
# NUXT_OAUTH_FACEBOOK_CLIENT_ID=
# NUXT_OAUTH_FACEBOOK_CLIENT_SECRET=

# Twitter OAuth
# NUXT_OAUTH_TWITTER_CLIENT_ID=
# NUXT_OAUTH_TWITTER_CLIENT_SECRET=